# Copy this file to ".env" and fill it in. Never commit .env.
# 1) In Telegram, talk to @BotFather -> /newbot -> copy the token it gives you.
# 2) Open your new bot, press Start, then run: npm run telegram:chatid
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# How often to check for new stories (minutes, default 3)
NOTIFY_INTERVAL_MIN=3
